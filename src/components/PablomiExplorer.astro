---
import { pablomiViews } from '../data/pablomi';
---
<div class="explorer" data-pablomi-explorer>
  <div class="explorer-stage">
    {pablomiViews.map((view, index) => (
      <section id={`view-${view.id}`} class="explorer-panel" role="tabpanel" aria-labelledby={`tab-${view.id}`} hidden={index !== 0}>
        <a class="panel-image-link" href={view.fullImage} data-lightbox data-gallery="home-pablomi" data-lightbox-id={`home-pablomi-${view.id}`} data-lightbox-alt={view.alt} data-lightbox-caption={`Pablomi / ${view.label} / current development build`} aria-label={`View full Pablomi ${view.label} screenshot`}><img src={view.image} alt={view.alt} width="1919" height="1079" loading="lazy" decoding="async" /></a>
        <div class="panel-caption">
          <div><span class="micro">CURRENT PABLOMI SCREEN / {view.label.toUpperCase()}</span><h3>{view.title}</h3><p>{view.detail}</p></div>
          <a href={view.fullImage} data-lightbox data-gallery="home-pablomi" data-lightbox-id={`home-pablomi-${view.id}`} data-lightbox-alt={view.alt} data-lightbox-caption={`Pablomi / ${view.label} / current development build`}>View full screenshot</a>
        </div>
      </section>
    ))}
  </div>
  <div class="explorer-controls">
    <div class="explorer-tabs" role="tablist" aria-label="Pablomi interface views">
      {pablomiViews.map((view, index) => (
        <button id={`tab-${view.id}`} type="button" role="tab" aria-controls={`view-${view.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-view={index}>
          <span class="micro">0{index + 1}</span>{view.label}
        </button>
      ))}
    </div>
    <div class="explorer-arrows">
      <button type="button" data-previous aria-label="Previous Pablomi view">←</button>
      <button type="button" data-next aria-label="Next Pablomi view">→</button>
    </div>
  </div>
  <p class="explorer-note">These are screenshots of the current development build. The interface may change during private testing.</p>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-pablomi-explorer]').forEach((explorer) => {
    const tabs = Array.from(explorer.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(explorer.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    let current = 0;
    function select(index: number, focus = false) {
      current = (index + tabs.length) % tabs.length;
      tabs.forEach((tab, i) => {
        const selected = i === current;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
      panels.forEach((panel, i) => { panel.hidden = i !== current; });
      if (focus) tabs[current].focus();
    }
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index));
      tab.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') { event.preventDefault(); select(current + 1, true); }
        if (event.key === 'ArrowLeft') { event.preventDefault(); select(current - 1, true); }
        if (event.key === 'Home') { event.preventDefault(); select(0, true); }
        if (event.key === 'End') { event.preventDefault(); select(tabs.length - 1, true); }
      });
    });
    explorer.querySelector('[data-previous]')?.addEventListener('click', () => select(current - 1));
    explorer.querySelector('[data-next]')?.addEventListener('click', () => select(current + 1));
  });
</script>
<style>
  .explorer { border: 1px solid var(--line); background: #191d1f; }
  .explorer-top { display: flex; justify-content: space-between; gap: 1rem; padding: .85rem 1rem; border-bottom: 1px solid var(--line); color: var(--green-soft); }
  .explorer-top .micro:last-child { font-size: .875rem; }
  .explorer-stage { position: relative; overflow: hidden; }
  .explorer-panel { animation: panel-in .45s ease both; }
  .panel-image-link { display: flex; align-items: center; justify-content: center; min-height: 0; padding: .75rem; overflow: hidden; background: #101b32; }
  .explorer-panel img { width: auto; max-width: 100%; max-height: min(46vh, 490px); height: auto; object-fit: contain; transition: transform .45s ease; }
  .explorer-panel:hover img { transform: scale(1.012); }
  .panel-caption { display: flex; justify-content: space-between; align-items: end; gap: 2rem; min-height: 112px; padding: clamp(.9rem, 1.5vw, 1.4rem); background: var(--paper); color: var(--ink); }
  .panel-caption .micro { color: #426636; }
  .panel-caption h3 { margin: .35rem 0; font-size: clamp(1.55rem, 2.4vw, 2.7rem); letter-spacing: -.065em; line-height: 1; }
  .panel-caption p { max-width: 40rem; margin: .4rem 0 0; line-height: 1.4; }
  .panel-caption a { flex: none; padding-bottom: .25rem; border-bottom: 1px solid #284e1f; color: #284e1f; text-decoration: none; font-size: .86rem; font-weight: 700; }
  .panel-caption a:hover { background: var(--green-soft); }
  .explorer-controls { display: flex; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--line); }
  .explorer-tabs { display: flex; flex: 1; min-width: 0; overflow-x: auto; scrollbar-width: thin; }
  .explorer-tabs button { display: flex; flex: 1; align-items: center; justify-content: center; gap: .55rem; min-width: 0; min-height: 52px; padding: .7rem 1rem; border: 0; border-right: 1px solid var(--line); background: transparent; color: var(--paper); cursor: pointer; transition: background .2s, color .2s; }
  .explorer-tabs button:hover { background: #27352c; }
  .explorer-tabs button[aria-selected='true'] { background: var(--green); color: var(--ink); }
  .explorer-tabs .micro { opacity: .65; }
  .explorer-arrows { display: flex; flex: none; }
  .explorer-arrows button { min-width: 56px; border: 0; border-left: 1px solid var(--line); background: transparent; color: var(--paper); font-size: 1.6rem; cursor: pointer; }
  .explorer-arrows button:hover { background: var(--green); color: var(--ink); }
  .explorer-note { margin: 0; padding: .75rem 1rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .82rem; }
  @keyframes panel-in { from { opacity: .45; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  @media(max-width: 800px) { .panel-caption { display: block; } .panel-caption a { display: inline-block; margin-top: 1rem; } .explorer-controls { display: block; } .explorer-tabs button { min-width: 92px; min-height: 56px; padding-inline: .5rem; } .explorer-arrows { justify-content: end; border-top: 1px solid var(--line); } .explorer-arrows button { min-height: 48px; } .explorer-panel img { max-height: none; width: 100%; } }
  @media(max-width: 420px) { .explorer-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); overflow: visible; } .explorer-tabs button { min-width: 0; min-height: 48px; gap: .25rem; padding: .4rem; border-bottom: 1px solid var(--line); font-size: .83rem; } .explorer-tabs .micro { display: none; } .panel-image-link { padding: .35rem; } }
  @media(prefers-reduced-motion: reduce) { .explorer-panel { animation: none; } .explorer-panel img { transition: none; } .explorer-panel:hover img { transform: none; } }
</style>
