---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/inner-pages.css';
---
<BaseLayout title="Contact" description="Contact Noah Adofina about software engineering opportunities, collaboration, or his projects.">
  <main id="main" class="inner-page contact-page">
    <header class="page-intro">
      <p class="eyebrow">NOAH ADOFINA / CONTACT</p>
      <h1>GET IN <span class="serif">touch.</span></h1>
      <p class="page-lede">I’m interested in software engineering opportunities, collaboration, and conversations about the projects here. Email is the best way to reach me.</p>
    </header>
    <section class="page-contact" aria-label="Contact details">
      <span class="micro contact-label">EMAIL ME</span>
      <p class="contact-main-email">noahadofina@gmail.com</p>
      <div class="contact-actions">
        <button type="button" data-copy-email aria-describedby="copy-email-status">Copy email</button>
        <a href="mailto:noahadofina@gmail.com">Compose in email app ↗</a>
        <a href="https://mail.google.com/mail/?view=cm&amp;fs=1&amp;to=noahadofina%40gmail.com" target="_blank" rel="noopener noreferrer">Compose in Gmail ↗</a>
      </div>
      <p id="copy-email-status" class="copy-email-status" role="status" aria-live="polite" data-copy-status></p>
      <div class="contact-detail-grid"><div><span class="micro">ELSEWHERE</span><div class="page-links"><a href="https://github.com/Noah-Adofina" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://www.linkedin.com/in/noah-adofina/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div></div><div><span class="micro">MY WORK</span><div class="page-links"><a href="/work">Projects ↗</a><a href="/resume">Resume ↗</a></div></div></div>
    </section>
  </main>
</BaseLayout>
<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const feedback = document.querySelector<HTMLElement>('[data-copy-status]');
  copyButton?.addEventListener('click', async () => {
    if (!feedback) return;
    try {
      await navigator.clipboard.writeText('noahadofina@gmail.com');
      feedback.textContent = 'Email address copied.';
      copyButton.textContent = 'Copied ✓';
    } catch {
      feedback.textContent = 'Copy unavailable. Select the address above to copy it.';
    }
  });
</script>
