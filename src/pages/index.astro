---
import BaseLayout from '../layouts/BaseLayout.astro';
import PablomiExplorer from '../components/PablomiExplorer.astro';
import { portfolioProjects } from '../data/portfolioProjects';
import '../styles/site.css';
const supportingProjects = portfolioProjects.filter((project) => ['comfy-cafe', 'inventory-tracker'].includes(project.slug));
---
<BaseLayout title="Independent software engineer" description="Noah Adofina is an independent software engineer building thoughtful, expressive software. Explore Pablomi and selected projects.">
  <main id="main" class="home">
    <section class="home-hero" aria-labelledby="hero-title">
      <div class="hero-topline micro"><div class="hero-eyebrow">INDEPENDENT SOFTWARE ENGINEER<span class="hero-dot" aria-hidden="true">●</span></div><span>A LITTLE BIT OF EVERYTHING</span></div>
      <div class="hero-grid">
        <div class="hero-copy">
          <h1 id="hero-title" class="hero-statement"><span>HEY, I'M</span><span class="serif pink hero-personal-name">Noah Adofina!</span></h1>
          <p class="hero-intro">I'm a self-taught software engineer. I started with games and small experiments, and now I'm building Pablomi independently. I care about the little details, making things intuitive, and building software that's genuinely nice to use.</p>
          <div class="hero-actions"><a class="button-green" href="/work">Explore my work</a><a class="text-link" href="/contact">Get in touch</a></div>
        </div>
        <div class="hero-art" aria-label="Screenshots from Pablomi, Noah's current project">
          <figure class="hero-shot hero-shot-main">
            <a href="/projects/full/login.png" data-lightbox data-gallery="hero-pablomi" data-lightbox-id="hero-pablomi-login" data-lightbox-alt="Current Pablomi sign-in screen with its blue mascot, wordmark, and desktop interface." data-lightbox-caption="Pablomi / current sign-in screen" aria-label="View full Pablomi sign-in screenshot"><img src="/projects/pablomi-login.webp" alt="Current Pablomi sign-in screen with its blue mascot, wordmark, and desktop interface." width="1919" height="1079" fetchpriority="high" decoding="async" /></a>
            <figcaption class="micro">PABLOMI / CURRENT BUILD</figcaption>
          </figure>
          <figure class="hero-shot hero-shot-secondary">
            <a href="/projects/full/chat.png" data-lightbox data-gallery="hero-pablomi" data-lightbox-id="hero-pablomi-chat" data-lightbox-alt="Pablomi chat view with a friends sidebar, conversation, and shared media." data-lightbox-caption="Pablomi / current chat interface" aria-label="View full Pablomi chat screenshot"><img src="/projects/pablomi-chat.webp" alt="Pablomi chat view with a friends sidebar, conversation, and shared media." width="1913" height="1079" decoding="async" /></a>
            <figcaption class="micro">CHAT / DESKTOP FIRST</figcaption>
          </figure>
        </div>
      </div>
      <div class="hero-bottomline micro"><span>SCROLL FOR THE WORK</span><span>PABLOMI IS BEING PREPARED FOR PRIVATE TESTING</span></div>
    </section>

    <section id="work" class="selected-work" aria-labelledby="work-title">
      <div class="section-heading"><div><p class="eyebrow">CURRENT FOCUS</p><h2 id="work-title">FEATURED <span class="serif">work.</span></h2></div><span class="section-number micro">01 / FLAGSHIP PROJECT</span></div>
      <div id="pablomi" class="flagship-showcase"><div class="flagship-intro">
        <a class="flagship-name" href="/work/pablomi" aria-label="Read the Pablomi case study"><span class="micro">INDEPENDENT PROJECT / DESKTOP FIRST</span><h3>PABLOMI<span class="green-dot">.</span></h3><span class="flagship-open">READ CASE STUDY <span aria-hidden="true">↗</span></span></a>
        <div class="flagship-copy"><p class="flagship-lede">A desktop-first social and messaging app for gamers, designed and developed independently.</p><p>Conversations, friends, profiles, themes, and voice share one space. The functional app is preparing for private testing.</p><div class="flagship-actions"><a class="text-link" href="https://pablomi.me" target="_blank" rel="noopener noreferrer">Visit Pablomi website ↗</a></div></div>
      </div>
      <PablomiExplorer /></div>
    </section>

    <section class="supporting-work" aria-labelledby="supporting-title">
      <div class="supporting-heading"><p class="eyebrow">EARLIER WORK</p><h2 id="supporting-title">PREVIOUS <span class="serif">projects.</span></h2></div>
      <div class="supporting-grid">
        {supportingProjects.map((project) => (
          <article class="support-project">
            <a class="support-image" href={project.images[0].full} data-lightbox data-gallery={`home-${project.slug}`} data-lightbox-id={`home-${project.slug}-0`} data-lightbox-alt={project.images[0].alt} data-lightbox-caption={project.images[0].caption} aria-label={`View ${project.title} screenshot`}>
              <img src={project.images[0].src} alt={project.images[0].alt} width="1600" height="900" loading="lazy" decoding="async" />
            </a>
            <div class="support-content"><span class="micro">{project.category.toUpperCase()}</span><h3>{project.title}</h3><p>{project.summary}</p><span class="support-stack">{project.stack.join(' / ')}</span><div class="project-actions">{project.links.map((link) => <a class="text-link" href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}</a>)}</div></div>
          </article>
        ))}
      </div>
      <div class="all-work-action"><span class="micro">MORE PROJECTS / EXPERIMENTS / ARCHIVE</span><a class="all-work-link" href="/work">See all projects <span aria-hidden="true">↗</span></a></div>
    </section>

    <section id="about" class="about-section" aria-labelledby="about-title">
      <p class="eyebrow">ABOUT ME</p>
      <div class="about-grid"><h2 id="about-title">I LIKE BUILDING<br /><span class="serif">useful things.</span></h2><div><p>I taught myself to code through games and small projects. Now I’m building Pablomi, a larger desktop and web app.</p><a class="text-link" href="/about">More about me</a></div></div>
    </section>

    <section id="contact" class="contact-section" aria-labelledby="contact-title">
      <p class="eyebrow">HAVE SOMETHING IN MIND?</p>
      <h2 id="contact-title">LET'S <span class="serif">talk.</span></h2>
      <div class="contact-bottom"><a class="contact-email" href="mailto:noahadofina@gmail.com">noahadofina@gmail.com</a><a class="text-link" href="/contact">Contact and links ↗</a></div>
    </section>
  </main>
</BaseLayout>
