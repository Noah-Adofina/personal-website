---
import ArrowIcon from '../../components/ArrowIcon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PablomiPlaceholder from '../../components/PablomiPlaceholder.astro';
import { projects } from '../../data/projects';
const [lead, ...rest] = projects;
---
<BaseLayout title="Electric Editorial" description="An editorial portfolio concept for Noah Adofina, featuring real software projects." active="editorial">
  <main id="main" class="editorial">
    <section class="editorial-hero" aria-labelledby="editorial-title">
      <div class="edition-mark micro">NOAH ADOFINA <span>—</span> SOFTWARE ENGINEER<br />SELECTED WORK / FIRST IMPRESSION</div>
      <div class="headline-wrap">
        <p class="eyebrow reveal">HELLO, I'M NOAH. I BUILD THINGS FOR THE WEB.</p>
        <h1 id="editorial-title" class="editorial-title">
          <span class="line reveal">SOFTWARE</span>
          <span class="line line-two reveal">WITH <em class="serif">a</em></span>
          <span class="line line-three reveal"><span class="green">PULSE.</span></span>
        </h1>
      </div>
      <figure class="hero-project">
        <div class="image-mat"><PablomiPlaceholder /></div>
        <figcaption><span class="micro">FEATURED PROJECT / {lead.category.toUpperCase()}</span><strong>{lead.title}</strong></figcaption>
      </figure>
      <div class="hero-bottom">
        <p>Code is the medium.<br /><span class="serif">Curiosity</span> is the method.</p>
        <span class="flagship-status micro">PABLOMI / IN DEVELOPMENT & PRIVATE TESTING</span>
        <span class="micro scroll-note">SCROLL TO EXPLORE ↓</span>
      </div>
    </section>
    <section class="editorial-index" aria-label="More selected projects">
      <div class="section-intro"><p class="eyebrow">BEYOND THE FIRST FRAME</p><h2>More work,<br /><span class="serif">same curiosity.</span></h2></div>
      <div class="index-rows">
        {rest.map((project) => (
          <a class="project-row" href={project.link} target="_blank" rel="noopener noreferrer">
            <span class="row-title">{project.title}</span>
            <span class="row-category">{project.category}</span>
            {project.image && <img src={project.image} alt={project.alt ?? ''} width="480" height="240" loading="lazy" />}
            <span class="row-open">VIEW PROJECT <ArrowIcon direction="up-right" /></span>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
<style>
  .editorial { overflow: clip; }
  .editorial-hero { position: relative; min-height: 820px; padding: clamp(2rem, 4vw, 4rem) clamp(1.25rem, 4vw, 4rem) 2rem; isolation: isolate; }
  .edition-mark { color: var(--muted); }
  .edition-mark span { color: var(--pink); }
  .headline-wrap { position: relative; z-index: 2; margin-top: clamp(3rem, 8vw, 8rem); }
  .headline-wrap .eyebrow { margin-bottom: 1.4rem; }
  .editorial-title { margin: 0; max-width: 1300px; font-size: clamp(5.3rem, 13.4vw, 14.8rem); font-weight: 700; letter-spacing: -.105em; line-height: .74; }
  .line { display: block; width: max-content; max-width: 100%; }
  .line-two { margin-left: 8vw; white-space: nowrap; }
  .line-three { margin-left: 1vw; }
  .line em { font-size: .9em; letter-spacing: -.07em; color: var(--pink); }
  .green { color: var(--green); }
  .hero-project { position: absolute; z-index: 1; width: clamp(340px, 42vw, 650px); top: 20%; right: -2%; margin: 0; transform: rotate(5deg); }
  .image-mat { padding: clamp(.7rem, 2vw, 1.8rem); background: var(--pink); box-shadow: 0 22px 55px rgba(0,0,0,.38); }
  .image-mat :global(.pablomi-placeholder) { height: clamp(220px, 24vw, 370px); }
  .image-mat img { width: 100%; height: clamp(220px, 24vw, 370px); object-fit: cover; object-position: center; }
  .hero-project figcaption { display: flex; justify-content: space-between; gap: 1rem; margin-top: .75rem; color: var(--paper); }
  .hero-project figcaption strong { font-size: .85rem; }
  .hero-bottom { display: flex; align-items: end; gap: 2.5rem; margin-top: clamp(4rem, 11vw, 10rem); }
  .hero-bottom p { margin: 0 auto 0 0; font-size: clamp(1.15rem, 2vw, 1.65rem); line-height: 1.1; }
  .hero-bottom .serif { color: var(--pink); font-size: 1.4em; }
  .flagship-status { padding: .8rem 1rem; border: 1px solid var(--green); color: var(--green); }
  .scroll-note { color: var(--muted); }
  .editorial-index { display: grid; grid-template-columns: 1fr 1.5fr; gap: clamp(2rem, 6vw, 7rem); padding: clamp(4rem, 8vw, 8rem) clamp(1.25rem, 4vw, 4rem); border-top: 1px solid var(--line); }
  .section-intro h2 { margin: 1rem 0; font-size: clamp(3rem, 5vw, 6rem); line-height: .95; letter-spacing: -.08em; }
  .section-intro .serif { color: var(--pink); }
  .project-row { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: .35rem 1rem; position: relative; min-height: 145px; padding: 1rem 0; border-top: 1px solid var(--line); text-decoration: none; }
  .project-row:last-child { border-bottom: 1px solid var(--line); }
  .row-title { font-size: clamp(1.5rem, 2.7vw, 3rem); font-weight: 600; letter-spacing: -.055em; }
  .row-category { grid-column: 1; color: var(--muted); }
  .project-row img { grid-column: 2; grid-row: 1 / span 2; width: 130px; height: 78px; object-fit: cover; filter: grayscale(1); transform: rotate(-4deg); transition: filter .3s, transform .3s; }
  .row-open { position: absolute; right: 0; bottom: .7rem; color: var(--green); font: .7rem 'DM Mono', monospace; }
  .project-row:hover img, .project-row:focus-visible img { filter: grayscale(0); transform: rotate(0); }
  .reveal { animation: rise-in .8s cubic-bezier(.2,.75,.2,1) both; }
  .editorial-title .line-two { animation-delay: .12s; }
  .editorial-title .line-three { animation-delay: .23s; }
  @keyframes rise-in { from { opacity: 0; transform: translateY(35px); } to { opacity: 1; transform: translateY(0); } }
  @media(max-width: 1000px) {
    .editorial-hero { min-height: 720px; }
    .hero-project { top: 31%; right: -12%; opacity: .75; }
    .editorial-title { font-size: clamp(5.2rem, 15vw, 10rem); }
    .hero-bottom { position: relative; z-index: 3; }
  }
  @media(max-width: 700px) {
    .editorial-hero { min-height: 0; padding-bottom: 3rem; }
    .headline-wrap { margin-top: 3.5rem; }
    .editorial-title { font-size: clamp(4.2rem, 15.5vw, 7rem); line-height: .82; }
    .line-two { margin-left: 4vw; }
    .hero-project { position: relative; top: auto; right: auto; width: 84%; margin: 2.7rem 0 0 auto; opacity: 1; transform: rotate(4deg); }
    .image-mat img { height: 220px; }
    .hero-bottom { align-items: start; flex-wrap: wrap; gap: 1.2rem; margin-top: 3rem; }
    .hero-bottom p { flex-basis: 100%; }
    .scroll-note { display: none; }
    .editorial-index { grid-template-columns: 1fr; }
    .project-row img { width: 100px; height: 64px; }
  }
  @media(max-width: 400px) { .editorial-title { font-size: 14.5vw; } .hero-project { width: 90%; } }
</style>
